<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+: no cloud backup and no device-to-device transfer of PulseStages' private data (settings, the night
    ledger and the log are derived from health data and stay on this device). Matches android:allowBackup="false".
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
