root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 140

[*.{kt,kts}]
ktlint_code_style = ktlint_official
max_line_length = 140
# @Composable functions use PascalCase names.
ktlint_function_naming_ignore_when_annotated_with = Composable

# Build scripts read many catalog values (libs.versions.x.get().toInt()); do not force those 4-operator chains onto
# separate lines there.
[*.gradle.kts]
ktlint_chain_method_rule_force_multiline_when_chain_operator_count_greater_or_equal_than = 5

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# The WTFPL text is kept byte-for-byte as served by http://www.wtfpl.net/txt/copying/ (CRLF line endings).
[LICENSE]
end_of_line = crlf
